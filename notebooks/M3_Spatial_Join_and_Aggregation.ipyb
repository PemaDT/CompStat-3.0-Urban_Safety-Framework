    {
      "cell_type": "code",
      "source": [
        "# Mounting Drive & Imports\n",
        "from google.colab import drive\n",
        "import pandas as pd\n",
        "import geopandas as gpd\n",
        "from shapely.geometry import Point\n",
        "import os\n",
        "import gc\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Project paths\n",
        "RAW_DIR   = '/content/drive/MyDrive/CompStat3_Project/data/raw'\n",
        "CLEAN_DIR = '/content/drive/MyDrive/CompStat3_Project/data/clean'\n",
        "os.makedirs(CLEAN_DIR, exist_ok=True)\n",
        "\n",
        "print(\"✅ Drive mounted and paths verified!\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "u5MBb12UsknJ",
        "outputId": "9f2d8e4a-c51f-40db-c656-4342ad31d98e"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Mounted at /content/drive\n",
            "✅ Drive mounted and paths verified!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Fetching Precinct Boundries (New 2026 Endpoint)\n",
        "import requests\n",
        "import geopandas as gpd\n",
        "from google.colab import userdata\n",
        "\n",
        "# 1. New 2026 Dataset ID\n",
        "# The previous 782d-637p was retired/archived.\n",
        "DATASET_ID = \"y76i-bdw7\"\n",
        "GEOJSON_URL = f\"https://data.cityofnewyork.us/api/geospatial/{DATASET_ID}?method=export&format=GeoJSON\"\n",
        "\n",
        "print(f\"⏳ Fetching 2026 Precinct Boundaries (ID: {DATASET_ID})...\")\n",
        "\n",
        "# 2. Advanced Headers to avoid 403/404 blocks\n",
        "headers = {\n",
        "    'X-App-Token': userdata.get('NYC_TOKEN'),\n",
        "    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'\n",
        "}\n",
        "\n",
        "try:\n",
        "    # Download using requests first (more robust than direct gpd.read_file)\n",
        "    response = requests.get(GEOJSON_URL, headers=headers, timeout=60)\n",
        "\n",
        "    if response.status_code == 200:\n",
        "        with open(\"/content/precincts.json\", \"wb\") as f:\n",
        "            f.write(response.content)\n",
        "        print(\"✅ GeoJSON downloaded successfully!\")\n",
        "\n",
        "        # Load and clean\n",
        "        precinct_gdf = gpd.read_file(\"/content/precincts.json\")\n",
        "        precinct_gdf = precinct_gdf.to_crs(epsg=4326)\n",
        "\n",
        "        # Standardize the 'precinct' column\n",
        "        precinct_gdf['precinct'] = precinct_gdf['precinct'].astype(str).str.strip()\n",
        "\n",
        "        print(f\"✅ Success! Loaded {len(precinct_gdf)} precinct polygons.\")\n",
        "        print(f\"Sample Precincts: {sorted(precinct_gdf['precinct'].unique()[:10])}\")\n",
        "    else:\n",
        "        print(f\"❌ Failed again. Status: {response.status_code}\")\n",
        "        print(f\"Server Message: {response.text}\")\n",
        "\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error: {e}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "r-XbOrQ7wBTk",
        "outputId": "f8b8466f-2bf4-4874-f79a-1af4357929ee"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏳ Fetching 2026 Precinct Boundaries (ID: y76i-bdw7)...\n",
            "✅ GeoJSON downloaded successfully!\n",
            "✅ Success! Loaded 78 precinct polygons.\n",
            "Sample Precincts: ['1', '10', '13', '14', '17', '18', '5', '6', '7', '9']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Loading M2 Data & Clean Coordinates\n",
        "print(\"⏳ Loading arrest and 311 datasets from Drive...\")\n",
        "\n",
        "# Load from your M2 Raw directory\n",
        "df_arrests = pd.read_parquet(f'{RAW_DIR}/arrests_2021_2025.parquet')\n",
        "df_311     = pd.read_parquet(f'{RAW_DIR}/311_2021_2025.parquet')\n",
        "\n",
        "# Convert dates to datetime objects\n",
        "df_arrests['arrest_date'] = pd.to_datetime(df_arrests['arrest_date'])\n",
        "df_311['created_date']    = pd.to_datetime(df_311['created_date'])\n",
        "\n",
        "# Drop rows with missing coordinates — essential for spatial joins\n",
        "df_arrests.dropna(subset=['latitude', 'longitude'], inplace=True)\n",
        "df_311.dropna(subset=['latitude', 'longitude'], inplace=True)\n",
        "\n",
        "# Ensure coordinates are floats\n",
        "df_arrests[['latitude', 'longitude']] = df_arrests[['latitude', 'longitude']].astype(float)\n",
        "df_311[['latitude', 'longitude']]     = df_311[['latitude', 'longitude']].astype(float)\n",
        "\n",
        "print(f\"✅ Data loaded: {len(df_arrests):,} arrests and {len(df_311):,} 311 requests.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "OoH7Aa0oxqHG",
        "outputId": "00506eca-50a0-4729-90f0-a25eadfc3122"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏳ Loading arrest and 311 datasets from Drive...\n",
            "✅ Data loaded: 932,817 arrests and 7,397,188 311 requests.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Spatial Join: Mapping 311 to Precincts\n",
        "print(\"⏳ Converting 311 data to GeoDataFrame (this uses RAM)...\")\n",
        "gdf_311 = gpd.GeoDataFrame(\n",
        "    df_311,\n",
        "    geometry=gpd.points_from_xy(df_311['longitude'], df_311['latitude']),\n",
        "    crs=\"EPSG:4326\"\n",
        ")\n",
        "del df_311 # Free memory immediately\n",
        "gc.collect()\n",
        "\n",
        "print(\"⏳ Running spatial join (311 → Precincts). This may take 5 minutes...\")\n",
        "gdf_311_joined = gpd.sjoin(\n",
        "    gdf_311,\n",
        "    precinct_gdf[['precinct', 'geometry']],\n",
        "    how='left',\n",
        "    predicate='within'\n",
        ")\n",
        "\n",
        "# Cleanup\n",
        "gdf_311_joined.rename(columns={'precinct': 'precinct_id'}, inplace=True)\n",
        "gdf_311_joined.dropna(subset=['precinct_id'], inplace=True)\n",
        "gdf_311_joined.drop(columns=['geometry', 'index_right'], inplace=True, errors='ignore')\n",
        "\n",
        "del gdf_311\n",
        "gc.collect()\n",
        "print(f\"✅ 311 Spatial Join complete! {len(gdf_311_joined):,} rows matched.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "WLvr_kJ5yA9N",
        "outputId": "33ca32f6-91df-4d2a-e307-15cfd6efffd3"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏳ Converting 311 data to GeoDataFrame (this uses RAM)...\n",
            "⏳ Running spatial join (311 → Precincts). This may take 5 minutes...\n",
            "✅ 311 Spatial Join complete! 7,395,501 rows matched.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Standardizing names and types\n",
        "df_arrests.rename(columns={'arrest_precinct': 'precinct_id'}, inplace=True)\n",
        "df_arrests['precinct_id'] = df_arrests['precinct_id'].astype(str).str.strip()\n",
        "\n",
        "# Add a date-only column for daily aggregation\n",
        "df_arrests['date'] = df_arrests['arrest_date'].dt.date\n",
        "\n",
        "print(f\"✅ Arrest precincts standardized. Unique precincts: {df_arrests['precinct_id'].nunique()}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1jXE4wikyYsP",
        "outputId": "ef8fffc6-bb22-4239-9a3e-ed9451a9f92b"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Arrest precincts standardized. Unique precincts: 79\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Aggregating to Daily Precinct Level\n",
        "print(\"⏳ Aggregating arrests...\")\n",
        "arrests_daily = df_arrests.groupby(['date', 'precinct_id']).size().reset_index(name='arrest_count')\n",
        "del df_arrests\n",
        "gc.collect()\n",
        "\n",
        "print(\"⏳ Aggregating 311 complaints...\")\n",
        "gdf_311_joined['date'] = pd.to_datetime(gdf_311_joined['created_date']).dt.date\n",
        "complaints_daily = (\n",
        "    gdf_311_joined\n",
        "    .groupby(['date', 'precinct_id', 'complaint_type'])\n",
        "    .size()\n",
        "    .reset_index(name='complaint_count')\n",
        ")\n",
        "\n",
        "del gdf_311_joined\n",
        "gc.collect()\n",
        "print(\"✅ Aggregations finished.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "KY8DWv5Ayh6D",
        "outputId": "df58e89d-5c8d-418c-fd18-7565721e0dd4"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏳ Aggregating arrests...\n",
            "⏳ Aggregating 311 complaints...\n",
            "✅ Aggregations finished.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Pivoting 311 Features & Final Merge\n",
        "print(\"⏳ Pivoting 311 categories into feature columns...\")\n",
        "complaints_pivot = complaints_daily.pivot_table(\n",
        "    index=['date', 'precinct_id'],\n",
        "    columns='complaint_type',\n",
        "    values='complaint_count',\n",
        "    fill_value=0\n",
        ").reset_index()\n",
        "\n",
        "# Clean up column names for Python\n",
        "complaints_pivot.columns = [c.lower().replace(' ', '_').replace('-', '_') for c in complaints_pivot.columns]\n",
        "\n",
        "# Merge Arrests and 311\n",
        "arrests_daily['date'] = pd.to_datetime(arrests_daily['date'])\n",
        "complaints_pivot['date'] = pd.to_datetime(complaints_pivot['date'])\n",
        "\n",
        "master_df = pd.merge(complaints_pivot, arrests_daily, on=['date', 'precinct_id'], how='left').fillna(0)\n",
        "master_df['arrest_count'] = master_df['arrest_count'].astype(int)\n",
        "\n",
        "print(f\"✅ Master dataset created! Shape: {master_df.shape}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "YTsYQSjGysw8",
        "outputId": "814cea53-68b6-4fba-ecca-a91c373f0f4e"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "⏳ Pivoting 311 categories into feature columns...\n",
            "✅ Master dataset created! Shape: (149886, 13)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Saving and Sanity check\n",
        "MASTER_PATH = f'{CLEAN_DIR}/master_precinct_daily.parquet'\n",
        "master_df.to_parquet(MASTER_PATH, index=False)\n",
        "\n",
        "print(\"✅ Master dataset saved to Google Drive!\")\n",
        "print(f\"   Path: {MASTER_PATH}\")\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"M3 SANITY CHECK\")\n",
        "print(\"=\"*50)\n",
        "print(f\"Date range:        {master_df['date'].min()} → {master_df['date'].max()}\")\n",
        "print(f\"Total rows:        {len(master_df):,}\")\n",
        "print(f\"Unique precincts:  {master_df['precinct_id'].nunique()}\")\n",
        "print(f\"Unique dates:      {master_df['date'].nunique()}\")\n",
        "print(f\"Avg arrests/day:   {master_df['arrest_count'].mean():.2f}\")\n",
        "print(f\"Missing values:\\n{master_df.isnull().sum()[master_df.isnull().sum() > 0]}\")\n",
        "print(\"=\"*50)"
      ],
      "metadata": {
