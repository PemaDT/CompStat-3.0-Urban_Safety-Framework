    {
      "cell_type": "code",
      "source": [
        "# Statistical Overview of Features\n",
        "print(\"--- Statistical Summary of Features ---\")\n",
        "display(master_df.describe().T)\n",
        "\n",
        "# Identify the top 5 most frequent 311 complaint types in the master\n",
        "complaint_cols = [c for c in master_df.columns if c not in ['date', 'precinct_id', 'arrest_count']]\n",
        "top_complaints = master_df[complaint_cols].sum().sort_values(ascending=False).head(5)\n",
        "\n",
        "print(\"\\n--- Top 5 Complaint Types in Master Dataset ---\")\n",
        "print(top_complaints)"
      ],
