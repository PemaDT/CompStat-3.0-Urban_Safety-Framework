    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Correlation Analysis\n",
        "# EDA: Correlation between Top 10 features and Arrests\n",
        "plt.figure(figsize=(10, 8))\n",
        "top_10_feats = top_complaints.index.tolist()\n",
        "corr_matrix = master_df[top_10_feats + ['arrest_count']].corr()\n",
        "\n",
        "sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', fmt=\".2f\")\n",
        "plt.title(\"Correlation Matrix: Quality-of-Life vs. Arrests\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 868
        },
        "id": "fUYobDl51-Bx",
        "outputId": "e68f400c-ef50-412d-bd12-3cf3133b43c7"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1000x800 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Temporal Trend (Disorder vs. Arrest)\n",
        "# Aggregate total city-wide activity per day\n",
        "# Note: uses 'illegal_parking' and 'noise___residential'\n",
        "daily_trends = master_df.groupby('date').agg({\n",
        "    'arrest_count': 'sum',\n",
        "    'illegal_parking': 'sum',\n",
        "    'noise___residential': 'sum'\n",
        "}).reset_index()\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.plot(daily_trends['date'], daily_trends['arrest_count'], label='Total Arrests', color='red', alpha=0.7)\n",
        "plt.plot(daily_trends['date'], daily_trends['noise___residential'] / 10, label='Residential Noise (Scale 1:10)', color='blue', alpha=0.5)\n",
        "plt.title('City-wide Daily Trends: Arrests vs. Residential Noise')\n",
        "plt.legend()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 545
        },
        "id": "Oqr7jNYv2SkS",
        "outputId": "822033b7-25eb-466d-ca51-9045a4e267ec"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Hotspot Precinct Identification\n",
        "# Find precincts with the highest average daily arrests\n",
        "hotspots = master_df.groupby('precinct_id')['arrest_count'].mean().sort_values(ascending=False).head(10)\n",
        "\n",
        "print(\"--- Top 10 High-Activity Precincts (Avg Arrests/Day) ---\")\n",
        "print(hotspots)\n",
        "\n",
        "# Sample data for the busiest precinct\n",
        "top_prec_id = hotspots.index[0]\n",
        "print(f\"\\n--- Sample Data for Highest Activity Precinct ({top_prec_id}) ---\")\n",
        "display(master_df[master_df['precinct_id'] == top_prec_id].head())"
      ],
